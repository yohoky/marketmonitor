{
  "name": "marketmonitor",
  "productName": "Marketmonitor",
  "version": "1.4.0",
  "description": "Windows 11 悬浮行情小组件（A股/基金/可转债）：多股同屏/滚动跳动切换 + 名称自动补全 + 异动提醒 + 透明度/位置/尺寸自定义",
  "main": "main.js",
  "author": "yohoky",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yohoky.marketmonitor",
    "productName": "Marketmonitor",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "compression": "maximum",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Marketmonitor",
      "uninstallDisplayName": "Marketmonitor",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "differentialPackage": false,
      "artifactName": "Marketmonitor-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  }
}
