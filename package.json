{
  "name": "marketmonitor",
  "productName": "Marketmonitor",
  "version": "1.4.5",
  "buildDate": "2026-09-17",
  "description": "Windows 悬浮行情小组件（A股/基金/可转债/港股/大盘指数）：多股同屏 + 滚动/跳动切换 + 名称自动补全 + 异动提醒（系统通知/提示音/邮件推送）+ 邮件定时汇总 + 背景与文字透明度分别可调 + 黑白摸鱼模式",
  "main": "main.js",
  "author": "yohoky",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yohoky.marketmonitor",
    "productName": "Marketmonitor",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "compression": "maximum",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Marketmonitor",
      "uninstallDisplayName": "Marketmonitor",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "differentialPackage": false,
      "artifactName": "Marketmonitor-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  }
}
